{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "ESLint",
  "extends": "./packages/tsconfig/base.json",
  "compilerOptions": {
    "noImplicitAny": false,
    "noEmit": true,
    "target": "ESNext",
    "baseUrl": ".",
    "paths": {
      "@extension/ui": [
        "packages/ui/index.ts"
      ],
      "@extension/ui/*": [
        "packages/ui/*"
      ],
      "@extension/browser": [
        "packages/browser/index.ts"
      ],
      "@extension/storage": [
        "packages/storage/index.mts"
      ],
      "@extension/storage/*": [
        "packages/storage/*"
      ],
      "@src/*": [
        "src/pages/AltS_search_newtab/src/*",
        "src/pages/popup/src/*",
        "src/pages/contentScript/src/*",
        "src/*"
      ]
    }
  },
  "include": [
    "eslint.config.ts",
    "src/**/*"
  ]
}
